# Frontend build variable: use the public Railway backend URL in production.
# Example: https://trimind-api-production.up.railway.app/api
VITE_API_URL=http://localhost:3001/api

# Backend
PORT=3001
# Comma-separated frontend origins, e.g. http://localhost:5174,https://your-frontend.vercel.app
FRONTEND_ORIGIN=http://localhost:5174
NODE_ENV=development
# Optional: enables the server AI provider adapter when implemented/configured.
ANTHROPIC_API_KEY=
